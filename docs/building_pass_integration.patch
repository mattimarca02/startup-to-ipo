+-- The building around the room: built for the current funding stage, replaced when the stage changes,
+-- nothing to do otherwise (PlotBuildingVisuals.sync checks). Looks only, like the room.
+local function syncBuilding(data)
+	if PlotBuildingVisuals and data.looks then
+		looks("building", PlotBuildingVisuals.sync, data.folder, data.looks.center, PlotArt, PlotBuilding, stageOf(data))
+	end
+end
+
 -- Runs every second (income loop): a new funding stage, or back to the Garage after an IPO,
 -- swaps the room with a quick flash. The bought props move along.
 local function syncRoom(data)
 	if data.looks and data.looks.stage ~= stageOf(data) then
 		looks("stage", PlotVisuals.setStage, data.looks, stageOf(data), true)
 	end
+	syncBuilding(data)
 end
 
